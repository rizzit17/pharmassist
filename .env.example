# ================================================================
# AIVOA Customer Complaint Management System — Environment Config
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# ================================================================

# ── Groq AI ──────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ── Database ──────────────────────────────────────────────────────
POSTGRES_DB=pharmassist
POSTGRES_USER=pharmassist
POSTGRES_PASSWORD=pharmassist_secret
DATABASE_URL=postgresql+asyncpg://pharmassist:pharmassist_secret@postgres:5432/pharmassist

# ── Auth ──────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_string_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── App Behavior ──────────────────────────────────────────────────
# Set to False to skip bearer token requirement for Swagger/curl testing
AUTH_REQUIRED=True
# Set to True to enable llama-3.3-70b-versatile for extraction/risk nodes
USE_LARGE_MODEL=False

# ── CORS ──────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── File Uploads ──────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# ── LLM Config ───────────────────────────────────────────────────
GROQ_TIMEOUT_SECONDS=20
GROQ_MAX_RETRIES=2
PRIMARY_MODEL=llama-3.1-8b-instant
SECONDARY_MODEL=llama-3.3-70b-versatile

# ── Frontend ──────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ── pgAdmin (optional) ────────────────────────────────────────────
PGADMIN_DEFAULT_EMAIL=admin@pharmassist.local
PGADMIN_DEFAULT_PASSWORD=admin
